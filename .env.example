# -----------------------------------------------------------------------------
# Account Payable Demo Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# All values shown are defaults.

# =============================================================================
# Run Mode Configuration
# =============================================================================

# Run mode: how the demo is deployed
# - local: run directly on host machine
# - docker: run in Docker containers
RUN_MODE=local

# LLM mode: where model inference happens
# - cloud: use cloud providers (OpenAI, Anthropic, DeepInfra)
# - local: use local Ollama server
LLM_MODE=cloud

# =============================================================================
# Application URLs
# =============================================================================

# Base URL for the demo application
APP_BASE_URL=https://www.localllamaland.com

# Finance demo queue URL (derived from base URL if not set)
FINANCE_QUEUE_URL=https://www.localllamaland.com/demo/finance/queue

# =============================================================================
# Predicate Sidecar Configuration
# =============================================================================

# Sidecar URL for authorization checks
PREDICATE_SIDECAR_URL=http://localhost:8787

# GitHub release repo for downloading sidecar binaries
SIDECAR_RELEASE_REPO=PredicateSystems/predicate-authority-sidecar

# Sidecar version to download (use 'latest' for most recent)
SIDECAR_VERSION=latest

# Path to the sidecar policy file (relative to demo root)
SIDECAR_POLICY_PATH=./policy.yaml

# =============================================================================
# Local LLM Configuration (Ollama)
# =============================================================================
# These settings are used when LLM_MODE=local

# Ollama server URL
# - For local mode: http://localhost:11434
# - For Docker mode with host Ollama: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Model for planning (complex reasoning, longer context)
# Suggested: qwen2.5:7b-instruct, llama3:8b-instruct, mistral:7b-instruct
OLLAMA_PLANNER_MODEL=qwen2.5:7b-instruct

# Model for execution (action generation, shorter context)
# Suggested: qwen2.5:4b-instruct, phi3:mini, llama3.2:3b
OLLAMA_EXECUTOR_MODEL=qwen2.5:4b-instruct

# =============================================================================
# Cloud LLM Configuration
# =============================================================================
# These settings are used when LLM_MODE=cloud

# API Keys (set the ones you need based on your provider choices)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPINFRA_API_KEY=

# Planner model configuration
# Provider: openai, anthropic, deepinfra
PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-4o

# Executor model configuration
# Provider: openai, anthropic, deepinfra
EXECUTOR_PROVIDER=openai
EXECUTOR_MODEL=gpt-4o-mini

# =============================================================================
# Demo Behavior
# =============================================================================

# Run browser in headless mode (no visible window)
HEADLESS=false

# Enable debug output
DEBUG=false

# Output directories for traces and artifacts
TRACE_OUTPUT_DIR=./traces
ARTIFACT_OUTPUT_DIR=./artifacts
